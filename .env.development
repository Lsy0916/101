# ===== 应用 =====
VITE_APP_TITLE=生涯心旅

# ===== REST =====
# 开发期走 Vite 代理（vite.config.ts 的 /api 转发）
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:8080

# ===== SignalR =====
# 开发期同源代理（vite.config.ts 的 /hubs ws 转发）
VITE_SIGNALR_HUB_URL=/hubs/notify

# ===== 多租户 =====
# 单校私有部署时填写租户 ID；留空则按 子域名 > ?tenant= > default 识别
VITE_TENANT_ID=
# 生产主域名（{tenantId}.{VITE_APP_DOMAIN}），留空则跳过子域名识别
VITE_APP_DOMAIN=

# ===== 登录 =====
# mock 开关：开发默认走 mock（沿用现有 stores/auth.js 的行为）
VITE_USE_MOCK_LOGIN=true
